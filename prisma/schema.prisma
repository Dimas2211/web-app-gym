generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Gym {
  id                    String                @id @default(uuid())
  name                  String
  slug                  String                @unique
  logo_url              String?
  address               String?
  phone                 String?
  email                 String?
  website               String?
  status                Status                @default(active)
  created_at            DateTime              @default(now())
  updated_at            DateTime              @updatedAt
  branches              Branch[]
  class_types           ClassType[]
  client_memberships    ClientMembership[]
  client_weekly_plans   ClientWeeklyPlan[]
  clients               Client[]
  membership_plans      MembershipPlan[]
  scheduled_classes     ScheduledClass[]
  trainer_availability  TrainerAvailability[]
  trainers              Trainer[]
  users                 User[]
  weekly_plan_templates WeeklyPlanTemplate[]
  settings              GymSettings?

  @@map("gyms")
}

model Branch {
  id                    String                @id @default(uuid())
  gym_id                String
  tenant_id             String?
  name                  String
  address               String?
  phone                 String?
  status                Status                @default(active)
  created_at            DateTime              @default(now())
  updated_at            DateTime              @updatedAt
  gym                   Gym                   @relation(fields: [gym_id], references: [id])
  client_memberships    ClientMembership[]
  client_weekly_plans   ClientWeeklyPlan[]
  clients               Client[]
  membership_plans      MembershipPlan[]
  scheduled_classes     ScheduledClass[]
  trainer_availability  TrainerAvailability[]
  trainers              Trainer[]
  users                 User[]
  weekly_plan_templates WeeklyPlanTemplate[]

  @@index([gym_id])
  @@map("branches")
}

model User {
  id                            String               @id @default(uuid())
  gym_id                        String
  tenant_id                     String?
  branch_id                     String?
  location_id                   String?
  email                         String               @unique
  password_hash                 String
  first_name                    String
  last_name                     String
  role                          UserRole
  status                        Status               @default(active)
  operational_code              String?
  avatar_url                    String?
  qr_token                      String?              @unique
  created_at                    DateTime             @default(now())
  updated_at                    DateTime             @updatedAt
  memberships_sold              ClientMembership[]   @relation("MembershipSales")
  clients_assigned              Client[]             @relation("ClientTrainer")
  client_profile                Client?              @relation("ClientUserLink")
  created_classes               ScheduledClass[]     @relation("ClassCreator")
  trainer_profile               Trainer?             @relation("TrainerUserLink")
  branch                        Branch?              @relation(fields: [branch_id], references: [id])
  gym                           Gym                  @relation(fields: [gym_id], references: [id])
  created_weekly_plan_templates WeeklyPlanTemplate[] @relation("TemplateCreator")
  products_created              Product[]            @relation("ProductCreatedBy")
  products_updated              Product[]            @relation("ProductUpdatedBy")
  product_locations_created     ProductLocation[]    @relation("ProductLocationCreatedBy")
  product_locations_updated     ProductLocation[]    @relation("ProductLocationUpdatedBy")
  inventory_movements_performed InventoryMovement[]  @relation("MovementPerformedBy")
  purchases_confirmed           Purchase[]           @relation("PurchaseConfirmedBy")
  purchases_cancelled           Purchase[]           @relation("PurchaseCancelledBy")
  purchases_created             Purchase[]           @relation("PurchaseCreatedBy")
  purchases_updated             Purchase[]           @relation("PurchaseUpdatedBy")
  suppliers_created             Supplier[]           @relation("SupplierCreatedBy")
  suppliers_updated             Supplier[]           @relation("SupplierUpdatedBy")
  customers_created             Customer[]           @relation("CustomerCreatedBy")
  customers_updated             Customer[]           @relation("CustomerUpdatedBy")
  sales_created                 Sale[]               @relation("SaleCreatedBy")
  sales_updated                 Sale[]               @relation("SaleUpdatedBy")
  sales_confirmed               Sale[]               @relation("SaleConfirmedBy")
  sales_cancelled               Sale[]               @relation("SaleCancelledBy")
  sale_payments_created         SalePayment[]        @relation("SalePaymentCreatedBy")
  dte_issuer_configs_created    DteIssuerConfig[]    @relation("DteIssuerConfigCreatedBy")
  dte_issuer_configs_updated    DteIssuerConfig[]    @relation("DteIssuerConfigUpdatedBy")
  dte_credentials_created       DteCredential[]      @relation("DteCredentialCreatedBy")
  dte_credentials_updated       DteCredential[]      @relation("DteCredentialUpdatedBy")
  dte_outgoing_docs_created     DteOutgoingDocument[] @relation("DteOutgoingDocumentCreatedBy")
  dte_outgoing_docs_updated     DteOutgoingDocument[] @relation("DteOutgoingDocumentUpdatedBy")
  dte_rendered_documents_generated  DteRenderedDocument[]  @relation("DteRenderedDocumentGeneratedBy")
  dte_deliveries_created            DteDelivery[]          @relation("DteDeliveryCreatedBy")
  dte_document_relations_created    DteDocumentRelation[]  @relation("DteDocumentRelationCreatedBy")
  dte_invalidation_events_requested DteInvalidationEvent[] @relation("DteInvalidationEventRequestedBy")

  @@unique([gym_id, operational_code])
  @@index([gym_id])
  @@index([branch_id])
  @@index([email])
  @@map("users")
}

model Goal {
  id                    String               @id @default(uuid())
  name                  String               @unique
  description           String?
  status                Status               @default(active)
  created_at            DateTime             @default(now())
  updated_at            DateTime             @updatedAt
  clients               Client[]
  weekly_plan_templates WeeklyPlanTemplate[] @relation("TemplateGoal")

  @@map("goals")
}

model Sport {
  id                    String               @id @default(uuid())
  name                  String               @unique
  description           String?
  status                Status               @default(active)
  created_at            DateTime             @default(now())
  updated_at            DateTime             @updatedAt
  clients               Client[]
  weekly_plan_templates WeeklyPlanTemplate[] @relation("TemplateSport")

  @@map("sports")
}

model MembershipPlan {
  id                 String             @id @default(uuid())
  gym_id             String
  tenant_id          String?
  branch_id          String?
  location_id        String?
  code               String?
  name               String
  description        String?
  duration_days      Int
  sessions_limit     Int?
  price              Decimal            @db.Decimal(10, 2)
  access_type        AccessType         @default(full)
  is_recurring       Boolean            @default(false)
  status             Status             @default(active)
  created_at         DateTime           @default(now())
  updated_at         DateTime           @updatedAt
  client_memberships ClientMembership[]
  branch             Branch?            @relation(fields: [branch_id], references: [id])
  gym                Gym                @relation(fields: [gym_id], references: [id])

  @@index([gym_id])
  @@index([branch_id])
  @@map("membership_plans")
}

model Client {
  id                      String             @id @default(uuid())
  gym_id                  String
  tenant_id               String?
  branch_id               String
  location_id             String?
  user_id                 String?            @unique
  first_name              String
  last_name               String
  document_id             String?
  birth_date              DateTime?          @db.Date
  gender                  Gender?
  email                   String?
  phone                   String?
  address                 String?
  emergency_contact_name  String?
  emergency_contact_phone String?
  sport_id                String?
  goal_id                 String?
  assigned_trainer_id     String?
  notes                   String?
  status                  Status             @default(active)
  operational_code        String?
  avatar_url              String?
  qr_token                String?            @unique
  created_at              DateTime           @default(now())
  updated_at              DateTime           @updatedAt
  class_attendance        ClassAttendance[]
  class_bookings          ClassBooking[]
  memberships             ClientMembership[]
  weekly_plans            ClientWeeklyPlan[]
  assigned_trainer        User?              @relation("ClientTrainer", fields: [assigned_trainer_id], references: [id])
  branch                  Branch             @relation(fields: [branch_id], references: [id])
  goal                    Goal?              @relation(fields: [goal_id], references: [id])
  gym                     Gym                @relation(fields: [gym_id], references: [id])
  sport                   Sport?             @relation(fields: [sport_id], references: [id])
  user                    User?              @relation("ClientUserLink", fields: [user_id], references: [id])

  @@unique([gym_id, operational_code])
  @@index([gym_id])
  @@index([branch_id])
  @@index([email])
  @@index([user_id])
  @@index([assigned_trainer_id])
  @@map("clients")
}

model ClientMembership {
  id                 String           @id @default(uuid())
  gym_id             String
  tenant_id          String?
  branch_id          String
  location_id        String?
  client_id          String
  membership_plan_id String
  start_date         DateTime         @db.Date
  end_date           DateTime         @db.Date
  price_at_sale      Decimal          @db.Decimal(10, 2)
  discount_amount    Decimal          @default(0) @db.Decimal(10, 2)
  final_amount       Decimal          @db.Decimal(10, 2)
  payment_status     PaymentStatus    @default(pending)
  status             MembershipStatus @default(active)
  sold_by_user_id    String?
  notes              String?
  created_at         DateTime         @default(now())
  updated_at         DateTime         @updatedAt
  branch             Branch           @relation(fields: [branch_id], references: [id])
  client             Client           @relation(fields: [client_id], references: [id])
  gym                Gym              @relation(fields: [gym_id], references: [id])
  membership_plan    MembershipPlan   @relation(fields: [membership_plan_id], references: [id])
  sold_by            User?            @relation("MembershipSales", fields: [sold_by_user_id], references: [id])

  @@index([gym_id])
  @@index([branch_id])
  @@index([client_id])
  @@index([membership_plan_id])
  @@index([end_date])
  @@map("client_memberships")
}

model Trainer {
  id                  String                @id @default(uuid())
  gym_id              String
  tenant_id           String?
  branch_id           String
  location_id         String?
  user_id             String?               @unique
  first_name          String
  last_name           String
  email               String?
  phone               String?
  specialty           String?
  notes               String?
  status              Status                @default(active)
  created_at          DateTime              @default(now())
  updated_at          DateTime              @updatedAt
  client_weekly_plans ClientWeeklyPlan[]
  scheduled_classes   ScheduledClass[]
  availability        TrainerAvailability[]
  branch              Branch                @relation(fields: [branch_id], references: [id])
  gym                 Gym                   @relation(fields: [gym_id], references: [id])
  user                User?                 @relation("TrainerUserLink", fields: [user_id], references: [id])

  @@index([gym_id])
  @@index([branch_id])
  @@index([user_id])
  @@map("trainers")
}

model TrainerAvailability {
  id          String   @id @default(uuid())
  gym_id      String
  tenant_id   String?
  branch_id   String
  location_id String?
  trainer_id  String
  day_of_week Int
  start_time  String
  end_time    String
  status      Status   @default(active)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  branch      Branch   @relation(fields: [branch_id], references: [id])
  gym         Gym      @relation(fields: [gym_id], references: [id])
  trainer     Trainer  @relation(fields: [trainer_id], references: [id])

  @@index([gym_id])
  @@index([branch_id])
  @@index([trainer_id])
  @@map("trainer_availability")
}

model ClassType {
  id                       String           @id @default(uuid())
  gym_id                   String
  tenant_id                String?
  code                     String?
  name                     String
  description              String?
  default_duration_minutes Int?
  capacity_default         Int?
  status                   Status           @default(active)
  created_at               DateTime         @default(now())
  updated_at               DateTime         @updatedAt
  gym                      Gym              @relation(fields: [gym_id], references: [id])
  scheduled_classes        ScheduledClass[]

  @@index([gym_id])
  @@map("class_types")
}

model ScheduledClass {
  id              String            @id @default(uuid())
  gym_id          String
  tenant_id       String?
  branch_id       String
  location_id     String?
  class_type_id   String
  trainer_id      String
  title           String
  class_date      DateTime          @db.Date
  start_time      String
  end_time        String
  capacity        Int
  room_name       String?
  is_personalized Boolean           @default(false)
  status          ClassStatus       @default(scheduled)
  notes           String?
  created_by      String?
  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt
  attendance      ClassAttendance[]
  bookings        ClassBooking[]
  branch          Branch            @relation(fields: [branch_id], references: [id])
  class_type      ClassType         @relation(fields: [class_type_id], references: [id])
  creator         User?             @relation("ClassCreator", fields: [created_by], references: [id])
  gym             Gym               @relation(fields: [gym_id], references: [id])
  trainer         Trainer           @relation(fields: [trainer_id], references: [id])

  @@index([gym_id])
  @@index([branch_id])
  @@index([class_type_id])
  @@index([trainer_id])
  @@index([class_date])
  @@map("scheduled_classes")
}

model ClassBooking {
  id                 String         @id @default(uuid())
  scheduled_class_id String
  client_id          String
  booking_status     BookingStatus  @default(confirmed)
  booked_at          DateTime       @default(now())
  notes              String?
  created_at         DateTime       @default(now())
  updated_at         DateTime       @updatedAt
  client             Client         @relation(fields: [client_id], references: [id])
  scheduled_class    ScheduledClass @relation(fields: [scheduled_class_id], references: [id])

  @@unique([scheduled_class_id, client_id])
  @@index([scheduled_class_id])
  @@index([client_id])
  @@map("class_bookings")
}

model ClassAttendance {
  id                 String           @id @default(uuid())
  scheduled_class_id String
  client_id          String
  attendance_status  AttendanceStatus @default(attended)
  checked_in_at      DateTime?
  notes              String?
  created_at         DateTime         @default(now())
  updated_at         DateTime         @updatedAt
  client             Client           @relation(fields: [client_id], references: [id])
  scheduled_class    ScheduledClass   @relation(fields: [scheduled_class_id], references: [id])

  @@unique([scheduled_class_id, client_id])
  @@index([scheduled_class_id])
  @@index([client_id])
  @@map("class_attendance")
}

model WeeklyPlanTemplate {
  id              String                  @id @default(uuid())
  gym_id          String
  tenant_id       String?
  branch_id       String?
  location_id     String?
  code            String?
  name            String
  target_gender   Gender?
  target_sport_id String?
  target_goal_id  String?
  target_level    PlanLevel?
  description     String?
  status          Status                  @default(active)
  created_by      String?
  created_at      DateTime                @default(now())
  updated_at      DateTime                @updatedAt
  client_plans    ClientWeeklyPlan[]
  days            WeeklyPlanTemplateDay[]
  branch          Branch?                 @relation(fields: [branch_id], references: [id])
  creator         User?                   @relation("TemplateCreator", fields: [created_by], references: [id])
  gym             Gym                     @relation(fields: [gym_id], references: [id])
  target_goal     Goal?                   @relation("TemplateGoal", fields: [target_goal_id], references: [id])
  target_sport    Sport?                  @relation("TemplateSport", fields: [target_sport_id], references: [id])

  @@index([gym_id])
  @@index([branch_id])
  @@map("weekly_plan_templates")
}

model WeeklyPlanTemplateDay {
  id               String             @id @default(uuid())
  template_id      String
  weekday          Int
  session_name     String?
  focus_area       String?
  duration_minutes Int                @default(60)
  exercise_block   String?
  trainer_notes    String?
  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt
  template         WeeklyPlanTemplate @relation(fields: [template_id], references: [id])

  @@unique([template_id, weekday])
  @@index([template_id])
  @@map("weekly_plan_template_days")
}

model ClientWeeklyPlan {
  id              String                @id @default(uuid())
  gym_id          String
  tenant_id       String?
  branch_id       String
  location_id     String?
  client_id       String
  template_id     String?
  trainer_id      String?
  start_date      DateTime              @db.Date
  end_date        DateTime              @db.Date
  status          Status                @default(active)
  assignment_type AssignmentType        @default(individual)
  notes           String?
  created_at      DateTime              @default(now())
  updated_at      DateTime              @updatedAt
  days            ClientWeeklyPlanDay[]
  branch          Branch                @relation(fields: [branch_id], references: [id])
  client          Client                @relation(fields: [client_id], references: [id])
  gym             Gym                   @relation(fields: [gym_id], references: [id])
  template        WeeklyPlanTemplate?   @relation(fields: [template_id], references: [id])
  trainer         Trainer?              @relation(fields: [trainer_id], references: [id])

  @@index([gym_id])
  @@index([branch_id])
  @@index([client_id])
  @@index([trainer_id])
  @@map("client_weekly_plans")
}

model ClientWeeklyPlanDay {
  id                    String           @id @default(uuid())
  client_weekly_plan_id String
  weekday               Int
  session_name          String?
  focus_area            String?
  duration_minutes      Int              @default(60)
  exercise_block        String?
  execution_status      ExecutionStatus  @default(pending)
  executed_at           DateTime?
  trainer_feedback      String?
  client_feedback       String?
  created_at            DateTime         @default(now())
  updated_at            DateTime         @updatedAt
  plan                  ClientWeeklyPlan @relation(fields: [client_weekly_plan_id], references: [id])

  @@unique([client_weekly_plan_id, weekday])
  @@index([client_weekly_plan_id])
  @@map("client_weekly_plan_days")
}

model GymSettings {
  id                 String   @id @default(uuid())
  gym_id             String   @unique
  tenant_id          String?
  staff_code_prefix  String   @default("A")
  staff_code_digits  Int      @default(4)
  staff_code_start   Int      @default(1010)
  client_code_prefix String   @default("C")
  client_code_digits Int      @default(4)
  client_code_start  Int      @default(1010)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
  gym                Gym      @relation(fields: [gym_id], references: [id])

  @@map("gym_settings")
}

// ── Configuración fiscal reusable del tenant ──────────────────────
// No depende de la vertical GYM. Cualquier vertical puede usarla.
// Contiene los parámetros que determinan si el tenant actúa como
// agente retenedor de IVA 1% al momento de registrar compras.
model TenantFiscalConfig {
  id                         String    @id @default(uuid())
  tenant_id                  String    @unique
  is_retention_agent         Boolean   @default(false)
  retention_threshold_amount Decimal?  @db.Decimal(10, 2)
  created_at                 DateTime  @default(now())
  updated_at                 DateTime  @updatedAt

  @@map("tenant_fiscal_config")
}

enum UserRole {
  super_admin
  branch_admin
  reception
  trainer
  client
}

enum Status {
  active
  inactive
  suspended
  deleted
}

enum AccessType {
  full
  limited
  classes_only
  virtual_only
}

enum Gender {
  male
  female
  other
  prefer_not_to_say
}

enum PaymentStatus {
  pending
  paid
  partial
  overdue
  refunded
}

enum MembershipStatus {
  active
  expired
  cancelled
  suspended
}

enum BookingStatus {
  confirmed
  cancelled
  waitlisted
}

enum AttendanceStatus {
  attended
  absent
  late
  cancelled
}

enum ClassStatus {
  scheduled
  in_progress
  completed
  cancelled
}

enum PlanLevel {
  beginner
  intermediate
  advanced
}

enum ExecutionStatus {
  pending
  completed
  skipped
  partial
}

enum AssignmentType {
  individual
  segmented
}

// ═════════════════════════════════════════════════════════════════
// COMMERCE — Catálogo maestro de productos (Etapa 11)
// Datos operativos por sucursal (stock, bodega) → Etapa 12: Inventario
// ═════════════════════════════════════════════════════════════════

// ── Enums commerce/products ──────────────────────────────────────

enum ProductType {
  PRODUCT
  SERVICE
}

// ── Enums commerce/inventory ─────────────────────────────────────

enum MovementType {
  // Operaciones disponibles en la Etapa 11
  INITIAL_LOAD    // carga inicial de existencias
  MANUAL_IN       // entrada manual autorizada
  MANUAL_OUT      // salida manual autorizada
  ADJUSTMENT_UP   // ajuste positivo por conteo físico
  ADJUSTMENT_DOWN // ajuste negativo por conteo físico
  // Reservados para integración futura — no implementados aún
  PURCHASE_IN     // entrada por orden de compra (Etapa 13)
  SALE_OUT        // salida por venta (Etapa 14)
  TRANSFER_IN     // entrada por transferencia entre locations (futuro)
  TRANSFER_OUT    // salida por transferencia entre locations (futuro)
  RETURN_IN       // devolución recibida (futuro)
  RETURN_OUT      // devolución enviada (futuro)
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
  BLOCKED_PURCHASE
  BLOCKED_SALE
}

// ── Enums commerce/purchases ─────────────────────────────────────

enum PurchaseStatus {
  DRAFT       // borrador editable
  CONFIRMED   // confirmado — genera movimientos PURCHASE_IN en inventory
  CANCELLED   // anulado desde DRAFT
}

enum PurchaseSourceType {
  MANUAL      // compra ingresada manualmente por el usuario
  DTE_IMPORT  // compra originada desde importación de factura electrónica (DTE)
}

enum DteImportStatus {
  UPLOADED               // JSON recibido, pendiente de revisión
  PENDING_REVIEW         // en proceso de revisión manual
  READY_TO_CREATE_PURCHASE // revisado, aprobado para crear compra
  LINKED                 // ya vinculado a una Purchase creada
  REJECTED               // descartado por el revisor
}

// ── Enums commerce/suppliers ─────────────────────────────────────

enum TaxpayerType {
  LARGE_TAXPAYER  // Gran contribuyente
  SMALL_TAXPAYER  // Pequeño contribuyente
  NON_TAXPAYER    // No contribuyente (persona natural sin NRC)
  FOREIGN         // Proveedor extranjero
}

// ── Unidades de medida (referencia global) ───────────────────────

model UnitOfMeasure {
  id         String    @id @default(uuid())
  name       String
  symbol     String
  status     Status    @default(active)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  products   Product[]

  @@unique([symbol])
  @@map("units_of_measure")
}

// ── Jerarquía del catálogo: categorías → líneas → sublíneas ──────

model ProductCategory {
  id          String        @id @default(uuid())
  tenant_id   String
  code        String
  name        String
  description String?
  status      Status        @default(active)
  created_at  DateTime      @default(now())
  updated_at  DateTime      @updatedAt
  lines       ProductLine[]
  products    Product[]

  @@unique([tenant_id, code])
  @@index([tenant_id])
  @@map("product_categories")
}

model ProductLine {
  id          String           @id @default(uuid())
  tenant_id   String
  category_id String
  code        String
  name        String
  status      Status           @default(active)
  created_at  DateTime         @default(now())
  updated_at  DateTime         @updatedAt
  category    ProductCategory  @relation(fields: [category_id], references: [id])
  sublines    ProductSubline[]
  products    Product[]

  @@unique([category_id, code])
  @@index([tenant_id])
  @@index([category_id])
  @@map("product_lines")
}

model ProductSubline {
  id         String      @id @default(uuid())
  tenant_id  String
  line_id    String
  code       String
  name       String
  status     Status      @default(active)
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt
  line       ProductLine @relation(fields: [line_id], references: [id])
  products   Product[]

  @@unique([line_id, code])
  @@index([tenant_id])
  @@index([line_id])
  @@map("product_sublines")
}

// ── Tablas auxiliares del catálogo ───────────────────────────────

model TaxRate {
  id         String    @id @default(uuid())
  tenant_id  String
  name       String
  rate       Decimal   @db.Decimal(5, 2)
  status     Status    @default(active)
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  products   Product[]

  @@index([tenant_id])
  @@map("tax_rates")
}

// ── Catálogos globales commerce/suppliers ────────────────────────
// Sin tenant_id — datos de sistema, cargados vía seed, no editables por usuario.

// CAT-022 El Salvador DTE — tipos de identificación del contribuyente
model IdentificationType {
  code        String  @id    // "00", "02", "03", "13", "37"
  name        String
  description String?
  status      Status  @default(active)

  @@map("identification_types")
}

// CAT-019 El Salvador MH — actividades económicas del contribuyente
model EconomicActivity {
  code    String  @id    // código CIIU adaptado MH, e.g., "01110"
  name    String
  section String?        // división o sección (agrupación de búsqueda)
  status  Status  @default(active)

  @@index([name])
  @@index([section])
  @@map("economic_activities")
}

// CAT-013 El Salvador MH — municipios con departamento embebido
model Municipality {
  id        String @id @default(uuid())
  dept_code String  // "01"–"14"
  dept_name String
  code      String  // código relativo al departamento, e.g., "01"
  name      String
  status    Status @default(active)

  @@unique([dept_code, code])
  @@index([dept_code])
  @@index([name])
  @@map("municipalities")
}

// Catálogo de países — ISO 3166-1 alpha-2
model Country {
  code   String @id   // "SV", "GT", "HN", "US", etc.
  name   String
  status Status @default(active)

  @@map("countries")
}

// ── Maestro de proveedores — commerce/suppliers (Etapa 12) ───────

model Supplier {
  // Identidad
  id             String  @id @default(uuid())
  tenant_id      String
  supplier_code  String           // código interno del sistema — único por tenant
  account_code   String?          // código de cuenta contable (externo, opcional)
  name           String           // nombre comercial / razón social
  legal_name     String?          // razón social formal si difiere del nombre

  // Clasificación tributaria — requerida para reglas de retención en compras
  taxpayer_type  TaxpayerType  @default(SMALL_TAXPAYER)

  // Identificación documental
  // id_type_code referencia IdentificationType.code — sin FK formal (validado por service)
  id_type_code   String?          // "00" | "02" | "03" | "13" | "37"
  dui            String?          // aplica si id_type_code = "13"
  nit            String?          // número de identificación tributaria (renta)
  nrc            String?          // número de registro de contribuyente (IVA)
  other_document String?          // pasaporte / carnet de residente / otro

  // Actividad económica CAT-019 (denormalizado — sin FK formal)
  activity_code  String?
  activity_name  String?

  // Dirección estructurada (denormalizada desde catálogos — sin FK formal)
  dept_code           String?
  dept_name           String?
  municipality_code   String?      // código relativo al departamento
  municipality_name   String?
  country_code        String?      // ISO alpha-2
  country_name        String?
  address_complement  String?      // domicilio libre / complemento

  // Contacto principal
  contact_name  String?
  contact_role  String?
  phone         String?
  phone_alt     String?
  email         String?
  whatsapp      String?

  // Estado
  status  Status  @default(active)
  is_subject_to_1pct_retention  Boolean  @default(false)

  // Auditoría
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  created_by  String?
  updated_by  String?

  // Relaciones
  created_by_user  User?       @relation("SupplierCreatedBy", fields: [created_by], references: [id])
  updated_by_user  User?       @relation("SupplierUpdatedBy", fields: [updated_by], references: [id])
  products                Product[]
  purchases               Purchase[]
  supplier_product_aliases SupplierProductAlias[]

  // Índices
  @@unique([tenant_id, supplier_code])
  @@index([tenant_id])
  @@index([tenant_id, status])
  @@index([tenant_id, name])
  @@index([nit])
  @@index([dui])
  @@map("suppliers")
}

// ── Catálogo maestro de productos ────────────────────────────────

model Product {
  // Identidad
  id           String  @id @default(uuid())
  tenant_id    String
  product_code String
  name         String
  description  String?

  // Tipo y estado
  product_type   ProductType
  status         ProductStatus @default(ACTIVE)
  is_stockable   Boolean
  allow_purchase Boolean
  allow_sale     Boolean

  // Clasificación
  category_id String
  line_id     String?
  subline_id  String?
  brand       String?

  // Logística del catálogo (sin datos por ubicación)
  unit_id      String
  package_unit String?
  supplier_id  String?
  sku          String?

  // Precios
  cost_price  Decimal? @db.Decimal(10, 2)
  sale_price  Decimal? @db.Decimal(10, 2)
  tax_rate_id String?

  // Auditoría
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  created_by String?
  updated_by String?

  // Relaciones
  category        ProductCategory @relation(fields: [category_id], references: [id])
  line            ProductLine?    @relation(fields: [line_id], references: [id])
  subline         ProductSubline? @relation(fields: [subline_id], references: [id])
  unit            UnitOfMeasure   @relation(fields: [unit_id], references: [id])
  supplier        Supplier?       @relation(fields: [supplier_id], references: [id])
  tax_rate        TaxRate?        @relation(fields: [tax_rate_id], references: [id])
  created_by_user User?           @relation("ProductCreatedBy", fields: [created_by], references: [id])
  updated_by_user User?           @relation("ProductUpdatedBy", fields: [updated_by], references: [id])
  product_locations        ProductLocation[]
  inventory_movements      InventoryMovement[]
  purchase_items           PurchaseItem[]
  supplier_product_aliases SupplierProductAlias[]
  sale_items               SaleItem[]

  // Índices
  @@unique([tenant_id, product_code])
  @@index([tenant_id])
  @@index([category_id])
  @@index([line_id])
  @@index([status])
  @@index([product_type])
  @@map("products")
}

// ═════════════════════════════════════════════════════════════════
// COMMERCE — Inventario operativo por location (Etapa 11)
// Capa operativa producto-location.
// products sigue siendo catálogo maestro; inventory es el estado real.
// ═════════════════════════════════════════════════════════════════

// ── Estado operativo actual: producto en una location ────────────
//
// Una fila = un producto concreto operando en una location concreta.
// Único por (tenant_id, location_id, product_id).
// El saldo solo se altera via InventoryMovement en transacción atómica.

model ProductLocation {
  // Identidad
  id          String @id @default(uuid())

  // Identidad transversal — mismo patrón que el resto del proyecto.
  // location_id es String sin FK formal; no existe modelo Location todavía.
  tenant_id   String
  location_id String

  // FK al catálogo maestro
  product_id  String

  // Estado operativo actual
  current_stock    Decimal @default(0) @db.Decimal(12, 4)
  min_stock        Decimal @default(0) @db.Decimal(12, 4)
  reorder_quantity Decimal @default(0) @db.Decimal(12, 4)

  // Ubicación física dentro de la location
  warehouse String?
  shelf     String?
  position  String?

  // Activación por location (independiente del status global del producto)
  is_active Boolean @default(true)

  // Auditoría
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  created_by String?
  updated_by String?

  // Relaciones
  product              Product             @relation(fields: [product_id], references: [id])
  created_by_user      User?               @relation("ProductLocationCreatedBy", fields: [created_by], references: [id])
  updated_by_user      User?               @relation("ProductLocationUpdatedBy", fields: [updated_by], references: [id])
  movements            InventoryMovement[]

  // Una sola fila operativa por producto en cada location del tenant
  @@unique([tenant_id, location_id, product_id])
  @@index([tenant_id])
  @@index([location_id])
  @@index([product_id])
  // Índice compuesto para la query principal: stock de una location completa
  @@index([tenant_id, location_id])
  // Índice para alertas derivadas (bajo mínimo, sin existencia)
  @@index([is_active])
  @@map("product_locations")
}

// ── Historial inmutable de hechos que explican el saldo ──────────
//
// Cada fila representa un evento que alteró el inventario.
// Sin updated_at: los movimientos no se modifican, solo se crean.
// quantity siempre > 0; la dirección (suma/resta) la determina movement_type.
// stock_before y resulting_stock se materializan en la transacción.

model InventoryMovement {
  // Identidad
  id String @id @default(uuid())

  // Identidad transversal
  tenant_id   String
  location_id String

  // Referencias
  product_id          String
  product_location_id String

  // Tipo y cantidad del movimiento
  movement_type MovementType
  quantity      Decimal      @db.Decimal(12, 4) // siempre positivo

  // Trazabilidad de costo (opcional, sin lógica de costeo avanzado)
  unit_cost Decimal? @db.Decimal(10, 2)

  // Saldos materializados en el momento del movimiento
  stock_before    Decimal @db.Decimal(12, 4)
  resulting_stock Decimal @db.Decimal(12, 4)

  // Referencia documental opcional (para integración futura con compras/ventas)
  reference_entity String? // ej: "purchase_order", "sale", "manual_adjustment"
  reference_id     String?
  reference_code   String?

  // Observaciones y auditoría
  notes        String?
  performed_by String?

  // Sin updated_at: registro inmutable
  created_at DateTime @default(now())

  // Relaciones
  product          Product         @relation(fields: [product_id], references: [id])
  product_location ProductLocation @relation(fields: [product_location_id], references: [id])
  performed_by_user User?          @relation("MovementPerformedBy", fields: [performed_by], references: [id])

  // Índices
  @@index([tenant_id])
  @@index([location_id])
  @@index([product_id])
  @@index([product_location_id])
  @@index([movement_type])
  // Índice para historial cronológico por location (query principal de historial)
  @@index([tenant_id, location_id, created_at])
  @@map("inventory_movements")
}

// ═════════════════════════════════════════════════════════════════
// COMMERCE — Compras a proveedores (Etapa 12)
//
// Purchase     = documento de compra (cabecera)
// PurchaseItem = línea de un documento de compra
//
// Al confirmar (DRAFT → CONFIRMED):
//   - cada línea con producto stockable genera un movimiento PURCHASE_IN
//   - el stock se actualiza exclusivamente vía inventory-movement.service
//
// No implementado en esta etapa: pagos, lotes, recepciones parciales,
// devoluciones, descuentos complejos, cuentas por pagar.
// ═════════════════════════════════════════════════════════════════

model Purchase {
  // Identidad
  id          String @id @default(uuid())

  // Identidad transversal — una compra pertenece a un tenant y una location
  tenant_id   String
  location_id String

  // Proveedor — obligatorio
  supplier_id String

  // Código del documento — correlativo numérico mensual por location
  purchase_code  String
  purchase_year  Int      // año extraído de purchase_date — para unicidad mensual
  purchase_month Int      // mes extraído de purchase_date — para unicidad mensual

  // Fecha del documento (solo fecha, sin hora)
  purchase_date DateTime @db.Date

  // Estado del ciclo de vida
  status PurchaseStatus @default(DRAFT)

  // Observaciones opcionales
  notes String?

  // Totales derivados de las líneas — se recalculan al agregar/editar/eliminar items
  subtotal     Decimal @default(0) @db.Decimal(10, 2)
  tax_amount   Decimal @default(0) @db.Decimal(10, 2)
  total_amount Decimal @default(0) @db.Decimal(10, 2)

  // Confirmación
  confirmed_at DateTime?
  confirmed_by String?

  // Cancelación
  cancelled_at DateTime?
  cancelled_by String?

  // Campos documentales base
  document_type      String?
  document_series    String?
  document_number    String?
  payment_condition  String?
  cancellation_type  String?

  // Retención IVA 1%
  retention_1pct_applies  Boolean  @default(false)
  retention_1pct_amount   Decimal  @default(0) @db.Decimal(10, 2)

  // DTE avanzado — columnas reservadas, UI stub
  generation_code  String?
  control_number   String?
  reception_stamp  String?

  // Origen y metadata DTE — preparado para importación futura de facturas electrónicas
  source_type          PurchaseSourceType @default(MANUAL)
  dte_processed_at     DateTime?          // fecha en que se procesó el DTE de origen
  dte_environment_code String?            // "00" prueba, "01" producción (códigos MH)

  // Auditoría
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  created_by String?
  updated_by String?

  // Relaciones
  supplier           Supplier           @relation(fields: [supplier_id], references: [id])
  confirmed_by_user  User?              @relation("PurchaseConfirmedBy",  fields: [confirmed_by], references: [id])
  cancelled_by_user  User?              @relation("PurchaseCancelledBy",  fields: [cancelled_by], references: [id])
  created_by_user    User?              @relation("PurchaseCreatedBy",    fields: [created_by],   references: [id])
  updated_by_user    User?              @relation("PurchaseUpdatedBy",    fields: [updated_by],   references: [id])
  items              PurchaseItem[]
  dte_import         PurchaseDteImport?

  // Correlativo único por location+mes+año — permite reinicio mensual
  @@unique([location_id, purchase_year, purchase_month, purchase_code])
  // Índice principal de operación: compras de una location concreta
  @@index([tenant_id, location_id])
  // Índice de filtro combinado: listado por estado dentro de una location
  @@index([tenant_id, location_id, status])
  // Índice para cálculo de próximo correlativo
  @@index([location_id, purchase_year, purchase_month])
  @@index([supplier_id])
  @@index([purchase_date])
  @@map("purchases")
}

model PurchaseItem {
  // Identidad
  id          String @id @default(uuid())

  // FK al documento
  purchase_id String

  // FK al catálogo maestro
  product_id String

  // Número de línea original del DTE (numItem). Opcional; null en compras manuales.
  dte_line_number Int?

  // Cantidad y costo unitario — siempre positivos
  quantity  Decimal @db.Decimal(12, 4)
  unit_cost Decimal @db.Decimal(10, 2)

  // Impuesto por línea (opcional; 0 si no aplica)
  tax_amount Decimal @default(0) @db.Decimal(10, 2)

  // Totales de línea — derivados: line_subtotal = qty × unit_cost
  line_subtotal Decimal @db.Decimal(10, 2)
  line_total    Decimal @db.Decimal(10, 2)

  // Observaciones opcionales por línea
  notes String?

  // Auditoría de línea
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Relaciones
  purchase Purchase @relation(fields: [purchase_id], references: [id])
  product  Product  @relation(fields: [product_id], references: [id])

  @@index([purchase_id])
  @@index([product_id])
  @@index([purchase_id, product_id])
  @@map("purchase_items")
}

// ═════════════════════════════════════════════════════════════════
// COMMERCE — Staging de importaciones DTE recibidas
//
// Guarda el JSON original de una factura electrónica recibida y
// metadata extraída mínima. Permite revisión manual antes de crear
// una Purchase. La relación con Purchase es opcional y tardía:
// se vincula solo cuando el revisor aprueba y crea la compra.
//
// No implementa parser, matching de productos ni matching de proveedores.
// ═════════════════════════════════════════════════════════════════

model PurchaseDteImport {
  // Identidad
  id          String @id @default(uuid())

  // Identidad transversal
  tenant_id   String
  location_id String

  // JSON original recibido — inmutable tras la carga
  raw_json Json

  // Metadata extraída del DTE (opcionales — se completan al parsear en fases futuras)
  dte_type         String?  // tipo de documento DTE (CCF, FAC, etc.)
  generation_code  String?  // código de generación único del DTE
  control_number   String?  // número de control
  reception_stamp  String?  // sello de recepción del MH
  processed_at     DateTime? // fecha de procesamiento del DTE
  environment_code String?  // "00" prueba, "01" producción

  // Datos del emisor extraídos del DTE (para revisión, sin vincular a Supplier)
  issuer_nit  String?
  issuer_nrc  String?
  issuer_name String?

  // Totales extraídos del DTE
  issued_at    DateTime?
  subtotal     Decimal? @db.Decimal(12, 2)
  tax_amount   Decimal? @db.Decimal(12, 2)
  total_amount Decimal? @db.Decimal(12, 2)
  item_count   Int?

  // Estado del ciclo de revisión
  status DteImportStatus @default(UPLOADED)

  // Vínculo opcional con Purchase — se establece al crear la compra desde este DTE
  // @unique garantiza que un DTE solo puede originar una compra
  purchase_id String? @unique

  // Auditoría
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  created_by  String?
  reviewed_at DateTime?
  reviewed_by String?

  // Relaciones
  purchase Purchase? @relation(fields: [purchase_id], references: [id])

  // Índices
  @@index([tenant_id, location_id])
  @@index([tenant_id, location_id, status])
  @@index([tenant_id, location_id, generation_code])
  @@map("purchase_dte_imports")
}

// ═════════════════════════════════════════════════════════════════
// COMMERCE — Alias proveedor-producto para matching DTE (Fase 7)
//
// Aprende equivalencias entre códigos/nombres del proveedor en DTE
// y productos internos del catálogo.
// Solo se crea si el usuario marca explícitamente la opción.
// No se crea automáticamente.
// ═════════════════════════════════════════════════════════════════

model SupplierProductAlias {
  id          String @id @default(uuid())
  tenant_id   String
  supplier_id String
  product_id  String

  // Valores originales del DTE (para trazabilidad y diagnóstico)
  supplier_product_code String?
  supplier_product_name String?

  // Valores normalizados usados en el matching:
  //   código: trim + uppercase
  //   nombre: trim + uppercase + espacios colapsados
  normalized_supplier_product_code String?
  normalized_supplier_product_name String?

  // Origen del alias (ej: "DTE_IMPORT")
  source    String?
  is_active Boolean @default(true)

  // Auditoría
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  created_by String?
  updated_by String?

  // Relaciones
  supplier Supplier @relation(fields: [supplier_id], references: [id])
  product  Product  @relation(fields: [product_id], references: [id])

  // Unique sobre código normalizado (NULLs no participan en unique en PostgreSQL,
  // por lo que el constraint solo aplica cuando el código está presente)
  @@unique([tenant_id, supplier_id, normalized_supplier_product_code])

  @@index([tenant_id, supplier_id])
  @@index([tenant_id, product_id])
  @@index([tenant_id, supplier_id, normalized_supplier_product_name])
  @@map("supplier_product_aliases")
}

// ═════════════════════════════════════════════════════════════════
// COMMERCE — Enums sales / dte outgoing / customers
// ═════════════════════════════════════════════════════════════════

enum SaleStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum SalePaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

enum DteOutgoingStatus {
  NOT_REQUIRED
  PENDING_GENERATION
  GENERATED
  SCHEMA_VALIDATED
  SIGNED
  SENT
  ACCEPTED
  REJECTED
  OBSERVED
  CONTINGENCY_PENDING
  INVALIDATION_PENDING
  INVALIDATED
}

enum DteEnvironment {
  TEST
  PRODUCTION
}

enum DteRenderedDocumentStatus {
  PENDING
  GENERATED
  FAILED
}

enum DteDeliveryType {
  CUSTOMER_EMAIL
  INTERNAL_EMAIL
  PRINT
  DOWNLOAD
}

enum DteDeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum DteDocumentRelationType {
  CREDIT_NOTE_OF
  DEBIT_NOTE_OF
  REPLACES
  REFERENCES
}

enum DteInvalidationStatus {
  DRAFT
  PENDING_SIGNATURE
  SIGNED
  SENT
  ACCEPTED
  REJECTED
  CANCELLED
}

// Tipo contribuyente para receptores fiscales (commerce/customers).
// Separado de TaxpayerType de suppliers — semántica diferente.
enum CustomerTaxpayerType {
  FINAL_CONSUMER       // Consumidor final — FE código 01
  REGISTERED_TAXPAYER  // Contribuyente registrado con NIT/NRC — CCFE código 03
  EXCLUDED_SUBJECT     // Sujeto excluido — FSEE código 14 (fuera del MVP)
}

// ═════════════════════════════════════════════════════════════════
// COMMERCE — Maestro de clientes/receptores fiscales (commerce/customers)
//
// Entidad propia de commerce. Independiente de gym/clients.
// Maestro a nivel tenant_id. Contiene datos fiscales para DTE outgoing.
// ═════════════════════════════════════════════════════════════════

model Customer {
  id                  String                @id @default(uuid())
  tenant_id           String
  customer_code       String
  name                String
  legal_name          String?

  // Clasificación tributaria para DTE
  taxpayer_type       CustomerTaxpayerType?

  // Identificación documental (CAT-022 MH)
  id_type_code        String?   // "13" DUI, "36" NIT, "37" Otro, "02" Carnet, "03" Pasaporte
  nit                 String?
  nrc                 String?
  dui                 String?

  // Actividad económica (CAT-019 MH — denormalizado, sin FK formal)
  activity_code       String?
  activity_name       String?

  // Dirección fiscal (denormalizada, sin FK formal)
  dept_code           String?
  municipality_code   String?
  address_complement  String?

  // Contacto
  phone               String?
  email               String?

  // Estado
  status              Status    @default(active)

  // Auditoría
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  created_by          String?
  updated_by          String?

  // Relaciones
  created_by_user     User?     @relation("CustomerCreatedBy", fields: [created_by], references: [id])
  updated_by_user     User?     @relation("CustomerUpdatedBy", fields: [updated_by], references: [id])
  sales               Sale[]

  @@unique([tenant_id, customer_code])
  @@index([tenant_id])
  @@index([tenant_id, nit])
  @@index([tenant_id, nrc])
  @@map("customers")
}

// ═════════════════════════════════════════════════════════════════
// COMMERCE — Ventas (commerce/sales)
//
// Sale         = cabecera del documento de venta
// SaleItem     = línea de producto dentro de la venta
// SalePayment  = pago básico asociado a la venta (sin integración cash)
//
// Al confirmar (DRAFT → CONFIRMED):
//   - cada SaleItem con is_stockable_snapshot=true genera SALE_OUT en inventory
//   - el stock se actualiza exclusivamente vía inventory-movement.service
//   - se crea DteOutgoingDocument con dte_status=PENDING_GENERATION
//
// La llamada al firmador/Hacienda ocurre fuera de la transacción Prisma.
// ═════════════════════════════════════════════════════════════════

model Sale {
  id                       String            @id @default(uuid())
  tenant_id                String
  location_id              String
  customer_id              String?

  // Correlativo interno de venta — independiente del correlativo DTE
  sale_code                String
  sale_year                Int
  sale_month               Int
  sale_sequence            Int

  sale_date                DateTime          @db.Date

  // Estados independientes
  status                   SaleStatus        @default(DRAFT)
  payment_status           SalePaymentStatus @default(UNPAID)

  // Tipo DTE principal esperado para la venta (CAT-002: 01=FE, 03=CCFE)
  // Representa la intención fiscal — no implica que el DTE haya sido generado.
  // El DTE real vive en DteOutgoingDocument.
  primary_dte_type_code    String    @default("01")

  // Campos documentales opcionales
  payment_method_code      String?
  condition_operation_code String?   // CAT-016 condición de operación DTE
  payment_term_code        String?   // CAT-018 plazo (01 Días, 02 Meses, 03 Años)
  payment_term_value       Int?      // cantidad de días/meses/años según payment_term_code

  // Totales derivados de las líneas
  subtotal                 Decimal   @default(0) @db.Decimal(10, 2)
  discount_amount          Decimal   @default(0) @db.Decimal(10, 2)
  tax_amount               Decimal   @default(0) @db.Decimal(10, 2)
  total_amount             Decimal   @default(0) @db.Decimal(10, 2)

  // Control de flujo de inventario
  inventory_moved          Boolean   @default(false)

  // Referencia opcional a sesión de caja — sin FK formal (cash pendiente)
  cash_session_id          String?

  notes                    String?

  // Confirmación
  confirmed_at             DateTime?
  confirmed_by             String?

  // Cancelación
  cancelled_at             DateTime?
  cancelled_by             String?

  // Auditoría
  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt
  created_by               String?
  updated_by               String?

  // Relaciones
  customer                 Customer?           @relation(fields: [customer_id], references: [id])
  confirmed_by_user        User?               @relation("SaleConfirmedBy", fields: [confirmed_by], references: [id])
  cancelled_by_user        User?               @relation("SaleCancelledBy", fields: [cancelled_by], references: [id])
  created_by_user          User?               @relation("SaleCreatedBy",   fields: [created_by],   references: [id])
  updated_by_user          User?               @relation("SaleUpdatedBy",   fields: [updated_by],   references: [id])
  items                    SaleItem[]
  payments                 SalePayment[]
  dte_documents            DteOutgoingDocument[]

  // Correlativos internos únicos por location
  @@unique([tenant_id, location_id, sale_code])
  @@unique([tenant_id, location_id, sale_year, sale_month, sale_sequence])
  @@index([tenant_id, location_id, status])
  @@index([tenant_id, location_id, sale_date])
  @@index([customer_id])
  @@index([created_by])
  @@map("sales")
}

model SaleItem {
  id                      String   @id @default(uuid())
  sale_id                 String
  product_id              String
  line_number             Int

  // Snapshots inmutables del producto al momento de la venta
  product_code_snapshot   String
  product_name_snapshot   String
  product_type_snapshot   String?
  is_stockable_snapshot   Boolean

  // Cantidad y precio
  quantity                Decimal  @db.Decimal(12, 4)
  unit_price              Decimal  @db.Decimal(10, 2)
  discount_amount         Decimal  @default(0) @db.Decimal(10, 2)

  // Impuesto por línea
  tax_rate_snapshot       Decimal? @db.Decimal(5, 2)
  tax_amount              Decimal  @default(0) @db.Decimal(10, 2)

  // Totales de línea
  line_subtotal           Decimal  @db.Decimal(10, 2)
  line_total              Decimal  @db.Decimal(10, 2)

  notes                   String?

  // Auditoría de línea
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt

  // Relaciones
  sale     Sale    @relation(fields: [sale_id], references: [id])
  product  Product @relation(fields: [product_id], references: [id])

  // line_number único por venta — permite líneas repetidas del mismo producto
  @@unique([sale_id, line_number])
  @@index([sale_id])
  @@index([product_id])
  @@map("sale_items")
}

model SalePayment {
  id                   String    @id @default(uuid())
  sale_id              String
  payment_method_code  String
  mh_payment_form_code String?   // CAT-017 forma de pago MH
  amount               Decimal   @db.Decimal(10, 2)
  paid_at              DateTime?
  reference            String?
  notes                String?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt
  created_by           String?

  // Relaciones
  sale             Sale  @relation(fields: [sale_id], references: [id])
  created_by_user  User? @relation("SalePaymentCreatedBy", fields: [created_by], references: [id])

  @@index([sale_id])
  @@index([payment_method_code])
  @@index([paid_at])
  @@map("sale_payments")
}

// ═════════════════════════════════════════════════════════════════
// COMMERCE — DTE Outgoing (commerce/dte)
//
// DteIssuerConfig      = configuración fiscal del emisor por tenant+location+environment
// DteCredential        = estructura para estrategia futura de credenciales cifradas
// DteCorrelative       = correlativo fiscal DTE separado del correlativo interno de Sale
// DteOutgoingDocument  = documento fiscal emitido — fuente de verdad del estado fiscal
// DteTransmissionLog   = log inmutable de comunicaciones con firmador/MH
//
// Reglas críticas:
//   - No guardar certificados, passwordPri ni tokens en texto plano.
//   - La firma y transmisión ocurren fuera de la transacción Prisma de confirmación.
//   - Sale.status y DteOutgoingDocument.dte_status son estados independientes.
// ═════════════════════════════════════════════════════════════════

model DteIssuerConfig {
  id                      String         @id @default(uuid())
  tenant_id               String
  location_id             String
  environment             DteEnvironment

  // Datos fiscales del emisor
  nit                     String
  nrc                     String?
  name                    String
  legal_name              String?
  activity_code           String?
  activity_name           String?

  // Establecimiento (CAT-009 MH)
  establishment_code      String?
  establishment_type_code String?
  point_of_sale_code      String?

  // Dirección fiscal
  dept_code               String?
  municipality_code       String?
  address_complement      String?

  // Contacto
  phone                   String?
  email                   String?

  is_active               Boolean        @default(true)

  // Auditoría
  created_at              DateTime       @default(now())
  updated_at              DateTime       @updatedAt
  created_by              String?
  updated_by              String?

  // Relaciones
  created_by_user    User?               @relation("DteIssuerConfigCreatedBy", fields: [created_by], references: [id])
  updated_by_user    User?               @relation("DteIssuerConfigUpdatedBy", fields: [updated_by], references: [id])
  credentials        DteCredential[]
  outgoing_documents DteOutgoingDocument[]

  @@unique([tenant_id, location_id, environment])
  @@index([tenant_id, location_id, is_active])
  @@map("dte_issuer_configs")
}

// Estructura para credenciales cifradas del emisor DTE.
// No guardar secretos en texto plano. encrypted_payload debe cifrarse con AES-256-GCM
// usando clave maestra en variable de entorno o KMS. secret_ref puede apuntar a
// un secrets manager externo (AWS Secrets Manager, Vault, etc.).
model DteCredential {
  id                     String    @id @default(uuid())
  issuer_config_id       String
  credential_type        String    // ej: "API_USER", "API_PASSWORD", "P12_CERT", "PRIVATE_KEY"
  encrypted_payload      String?   @db.Text  // payload cifrado — NUNCA texto plano
  secret_ref             String?             // referencia a secrets manager externo
  encryption_key_version String?             // versión de clave maestra usada
  expires_at             DateTime?
  is_active              Boolean   @default(true)
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt
  created_by             String?
  updated_by             String?

  // Relaciones
  issuer_config    DteIssuerConfig @relation(fields: [issuer_config_id], references: [id])
  created_by_user  User?           @relation("DteCredentialCreatedBy", fields: [created_by], references: [id])
  updated_by_user  User?           @relation("DteCredentialUpdatedBy", fields: [updated_by], references: [id])

  @@index([issuer_config_id])
  @@index([credential_type])
  @@index([is_active])
  @@map("dte_credentials")
}

// Correlativo fiscal DTE separado del correlativo interno de Sale.
// El incremento debe ocurrir dentro de una transacción atómica para evitar duplicados.
model DteCorrelative {
  id              String         @id @default(uuid())
  tenant_id       String
  location_id     String
  environment     DteEnvironment
  dte_type_code   String         // "01" FE, "03" CCFE, futuros según CAT-002
  year            Int
  last_sequence   Int            @default(0)
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt

  @@unique([tenant_id, location_id, environment, dte_type_code, year])
  @@index([tenant_id, location_id])
  @@map("dte_correlatives")
}

// Documento fiscal emitido. Fuente de verdad del estado fiscal ante Hacienda.
// Relación N desde Sale (en MVP se controla 1 documento FE/CCFE activo por venta
// mediante regla de servicio, no a nivel de schema).
model DteOutgoingDocument {
  id                   String            @id @default(uuid())
  tenant_id            String
  location_id          String
  sale_id              String
  issuer_config_id     String?

  dte_type_code        String            // "01" FE, "03" CCFE (CAT-002)
  generation_code      String?           @unique  // codigoGeneracion UUID — inmutable una vez asignado
  control_number       String?
  reception_stamp      String?
  environment          DteEnvironment

  // Estado fiscal — independiente de Sale.status
  dte_status           DteOutgoingStatus @default(PENDING_GENERATION)

  // Documento DTE
  json_document        Json?             // JSON DTE antes de firma
  signed_jws           String?           @db.Text  // JWS firmado recibido del firmador
  mh_response          Json?             // respuesta sanitizada del MH
  observations         Json?             // observaciones del MH si aplica
  rejection_reason     String?

  retry_count          Int               @default(0)

  // Timestamps del ciclo de vida fiscal
  issued_at            DateTime?
  generated_at         DateTime?
  schema_validated_at  DateTime?
  signed_at            DateTime?
  sent_at              DateTime?
  accepted_at          DateTime?
  rejected_at          DateTime?
  observed_at          DateTime?
  invalidated_at       DateTime?

  // Auditoría
  created_at           DateTime          @default(now())
  updated_at           DateTime          @updatedAt
  created_by           String?
  updated_by           String?

  // Relaciones
  sale              Sale              @relation(fields: [sale_id], references: [id])
  issuer_config     DteIssuerConfig?  @relation(fields: [issuer_config_id], references: [id])
  created_by_user   User?             @relation("DteOutgoingDocumentCreatedBy", fields: [created_by], references: [id])
  updated_by_user   User?             @relation("DteOutgoingDocumentUpdatedBy", fields: [updated_by], references: [id])
  transmission_logs   DteTransmissionLog[]
  rendered_documents  DteRenderedDocument[]
  deliveries          DteDelivery[]
  source_relations    DteDocumentRelation[] @relation("SourceDteDocument")
  related_in_relations DteDocumentRelation[] @relation("RelatedDteDocument")
  invalidation_events DteInvalidationEvent[]

  @@index([tenant_id, location_id, dte_status])
  @@index([sale_id])
  @@index([dte_type_code])
  @@index([control_number])
  @@index([reception_stamp])
  @@map("dte_outgoing_documents")
}

// Log inmutable de cada intento de comunicación con firmador o MH.
// No guardar tokens, certificados ni passwordPri.
model DteTransmissionLog {
  id              String   @id @default(uuid())
  dte_document_id String
  attempt_number  Int
  operation_type  String   // SIGN, SEND, QUERY, INVALIDATE, CONTINGENCY, AUTH
  request_url     String?
  http_status     Int?
  response_body   Json?    // respuesta sanitizada — sin secretos ni tokens
  error_message   String?
  created_at      DateTime @default(now())

  // Relaciones
  dte_document  DteOutgoingDocument @relation(fields: [dte_document_id], references: [id])

  @@index([dte_document_id])
  @@index([operation_type])
  @@index([created_at])
  @@map("dte_transmission_logs")
}

// ═════════════════════════════════════════════════════════════════
// COMMERCE — DTE Catálogos, Representación, Delivery, Relaciones e Invalidación (Fase 3C)
// ═════════════════════════════════════════════════════════════════

// ─── DteCatalogItem ──────────────────────────────────────────────
// Catálogos DTE oficiales MH sin tenant_id — datos de sistema.
// Cargados vía seed. No editables por usuario.
// Cubre: CAT-001, CAT-002, CAT-003, CAT-004, CAT-005, CAT-011,
//        CAT-016, CAT-017, CAT-018, CAT-022, CAT-024, etc.
model DteCatalogItem {
  id           String   @id @default(uuid())
  catalog_code String   // "CAT-001", "CAT-002", etc.
  item_code    String   // "00", "01", "03", etc.
  item_label   String
  description  String?
  applies_to   String?  // tipo de documento u otro contexto de aplicación
  version      String   @default("1")
  sort_order   Int?
  metadata     Json?
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@unique([catalog_code, item_code, version])
  @@index([catalog_code])
  @@index([catalog_code, is_active])
  @@map("dte_catalog_items")
}

// ─── DteRenderedDocument ─────────────────────────────────────────
// Representación gráfica del DTE — principalmente PDF.
// No genera PDF real en esta fase. Solo modela la estructura.
model DteRenderedDocument {
  id              String                    @id @default(uuid())
  tenant_id       String
  location_id     String
  dte_document_id String

  format          String                    // "PDF" en implementación futura
  storage_key     String?                   // ruta en almacenamiento (S3, local, etc.)
  public_url      String?
  file_name       String?
  mime_type       String?                   // "application/pdf"
  file_size       Int?                      // bytes

  status          DteRenderedDocumentStatus @default(PENDING)
  generated_at    DateTime?
  generated_by    String?
  error_message   String?

  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  // Relaciones
  dte_document      DteOutgoingDocument @relation(fields: [dte_document_id], references: [id])
  generated_by_user User?               @relation("DteRenderedDocumentGeneratedBy", fields: [generated_by], references: [id])
  deliveries        DteDelivery[]

  @@index([tenant_id, location_id])
  @@index([dte_document_id])
  @@index([status])
  @@map("dte_rendered_documents")
}

// ─── DteDelivery ─────────────────────────────────────────────────
// Registro de envíos del DTE: email cliente, email interno, impresión, descarga.
// No envía email real en esta fase. Solo modela la estructura.
model DteDelivery {
  id                   String            @id @default(uuid())
  tenant_id            String
  location_id          String
  dte_document_id      String
  rendered_document_id String?

  delivery_type        DteDeliveryType
  recipient_email      String?
  cc                   String?
  bcc                  String?
  subject              String?
  provider             String?           // "resend", "smtp", etc. — futuro
  provider_message_id  String?

  status               DteDeliveryStatus @default(PENDING)
  sent_at              DateTime?
  attempted_at         DateTime?
  error_message        String?

  created_by           String?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  // Relaciones
  dte_document      DteOutgoingDocument  @relation(fields: [dte_document_id], references: [id])
  rendered_document DteRenderedDocument? @relation(fields: [rendered_document_id], references: [id])
  created_by_user   User?                @relation("DteDeliveryCreatedBy", fields: [created_by], references: [id])

  @@index([tenant_id, location_id])
  @@index([dte_document_id])
  @@index([delivery_type])
  @@index([status])
  @@map("dte_deliveries")
}

// ─── DteDocumentRelation ─────────────────────────────────────────
// Relación entre documentos DTE: nota de crédito → factura original, etc.
// No implementa lógica de creación de notas en esta fase.
model DteDocumentRelation {
  id                      String                  @id @default(uuid())
  tenant_id               String
  location_id             String
  source_dte_document_id  String                  // documento origen (ej: nota de crédito)
  related_dte_document_id String                  // documento referenciado (ej: factura original)

  relation_type           DteDocumentRelationType
  reason_code             String?                 // código de razón según catálogo DTE
  reason_text             String?
  amount                  Decimal?                @db.Decimal(10, 2)

  created_by              String?
  created_at              DateTime  @default(now())

  // Relaciones
  source_document  DteOutgoingDocument @relation("SourceDteDocument",  fields: [source_dte_document_id],  references: [id])
  related_document DteOutgoingDocument @relation("RelatedDteDocument", fields: [related_dte_document_id], references: [id])
  created_by_user  User?               @relation("DteDocumentRelationCreatedBy", fields: [created_by], references: [id])

  @@index([tenant_id, location_id])
  @@index([source_dte_document_id])
  @@index([related_dte_document_id])
  @@map("dte_document_relations")
}

// ─── DteInvalidationEvent ────────────────────────────────────────
// Evento fiscal de invalidación. Separado de Sale y de DteOutgoingDocument.
// No transmite invalidación en esta fase. Solo modela la estructura.
model DteInvalidationEvent {
  id              String                @id @default(uuid())
  tenant_id       String
  location_id     String
  dte_document_id String

  invalidation_type_code String        // CAT-024 tipo de invalidación
  reason                 String
  event_json             Json?
  signed_jws             String?       @db.Text

  // Respuesta del Ministerio de Hacienda
  mh_estado           String?
  mh_sello_recibido   String?
  mh_codigo_msg       String?
  mh_descripcion_msg  String?
  mh_observaciones    Json?

  status          DteInvalidationStatus @default(DRAFT)

  // Timestamps del ciclo de vida fiscal
  requested_at    DateTime?
  sent_at         DateTime?
  accepted_at     DateTime?
  rejected_at     DateTime?

  last_error      String?
  requested_by    String?

  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  // Relaciones
  dte_document      DteOutgoingDocument @relation(fields: [dte_document_id], references: [id])
  requested_by_user User?               @relation("DteInvalidationEventRequestedBy", fields: [requested_by], references: [id])

  @@index([tenant_id, location_id])
  @@index([dte_document_id])
  @@index([status])
  @@map("dte_invalidation_events")
}
