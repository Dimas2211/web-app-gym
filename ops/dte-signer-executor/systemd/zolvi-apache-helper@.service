# FISCAL-ONBOARDING — helper privilegiado de Apache/cPanel para el ejecutor de firmadores.
#
# Por qué existe: rebuildhttpdconf (cPanel) escribe en rutas de /etc, /var/cpanel y
# /usr/local/cpanel que cPanel no documenta y que cambian entre versiones; dentro del
# sandbox del ejecutor (ProtectSystem=strict, ProtectHome, PrivateTmp) puede fallar
# aunque funcione como root interactivo. Esta unidad lo ejecuta en el contexto que
# cPanel espera, sin abrir el sandbox del proceso que sí está expuesto a la red.
# (Hipótesis pendiente de confirmar con diagnostics/apache-rebuild-readonly-diagnostic.sh.)
#
# Superficie: SOLO tres instancias válidas, validadas por el script con comparación exacta:
#   zolvi-apache-helper@rebuild.service     -> rebuildhttpdconf
#   zolvi-apache-helper@configtest.service  -> apachectl -t
#   zolvi-apache-helper@graceful.service    -> apachectl -k graceful
# Cualquier otra instancia (restart, stop, "rebuild;id", escapes \x2d…) sale con 64
# sin ejecutar ningún comando. %i se pasa como UN argumento literal (escapado, sin shell).
# Nunca reinicia Apache. Sin [Install]: solo arranca bajo demanda del ejecutor.
#
# Quién puede arrancarla: solo root (o quien polkit autorice para manage-units, por
# defecto solo administradores). No hay socket, timer ni puerto asociado.
#
# Auditoría de privilegios — qué se restringe y qué no (y por qué):
#   SÍ  NoNewPrivileges, ProtectKernelModules/Logs/Tunables, ProtectClock, ProtectHostname,
#       RestrictRealtime, RestrictNamespaces, LockPersonality, SystemCallArchitectures,
#       ProtectControlGroups: solo bloquean módulos de kernel, sysctl, reloj, hostname,
#       cgroups y namespaces; rebuildhttpdconf y apachectl no escriben ahí. Si el
#       diagnóstico real mostrara lo contrario, quitar SOLO la directiva implicada.
#   NO  ProtectSystem/ProtectHome/ReadWritePaths: es justo lo que rompe rebuildhttpdconf
#       (escritura en rutas no documentadas). Recortarlo de nuevo reproduciría el fallo.
#   NO  PrivateTmp: cPanel usa /tmp compartido para algunos locks/temporales.
#   NO  CapabilityBoundingSet: rebuild necesita chown/fowner/dac_override y graceful kill;
#       la lista exacta no está documentada por cPanel. Revisar tras el diagnóstico.
#   NO  PrivateNetwork/RestrictAddressFamilies: cPanel puede consultar cpsrvd/DNS local.
#   NO  MemoryDenyWriteExecute: el helper es Node (JIT) y cPanel usa Perl con XS.
[Unit]
Description=Zolvi Apache helper (%i) — predefined cPanel/Apache operation
AssertPathExists=/opt/zolvi-signer-executor/zolvi-apache-helper.mjs
# Evita arrancar si Apache no está activo: graceful/configtest no deben "levantar" nada.
Requisite=httpd.service
After=httpd.service

[Service]
Type=oneshot
ExecStart=/usr/bin/node /opt/zolvi-signer-executor/zolvi-apache-helper.mjs "%i"
TimeoutStartSec=120
# Resultado saneado para el ejecutor; se conserva hasta el siguiente arranque.
RuntimeDirectory=zolvi-apache-helper
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0022
NoNewPrivileges=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
