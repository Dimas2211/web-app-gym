# FISCAL-ONBOARDING — helper privilegiado de Apache/cPanel para el ejecutor de firmadores.
#
# Por qué existe (causa CONFIRMADA en el VPS, APPLY 2026-11-10 22:28 CST): dentro del
# sandbox del ejecutor, rebuildhttpdconf falla en
#   - Cpanel::Template::Plugin::ApacheConfig::generate_cloudflare_config: crear
#     /etc/apache2/conf.d/includes/cloudflare.conf.lock → Read-only file system
#     (ProtectSystem=strict; /etc/apache2/conf.d no está en ReadWritePaths);
#   - Cpanel::FileProtect::Sync::sync_user_homedir: /home/<usuario>/.htpasswds →
#     Permission denied (ProtectHome=true).
# Como root interactivo ambas rutas son escribibles y el rebuild funciona. Esta unidad
# lo ejecuta en ese mismo contexto (sin ProtectSystem/ProtectHome/ReadWritePaths), sin
# abrir el sandbox del proceso expuesto a la red. Lo que cPanel haga en esas rutas es su
# comportamiento normal de cualquier rebuild como root; Zolvi no cambia permisos allí.
#
# Node.js: ea-nodejs22 de EasyApache (no hay node en el PATH de root del VPS). Mantener
# igual que en zolvi-signer-executor.service.
#
# Superficie: SOLO tres operaciones; instancia = <op>-<nonce>, validada por el script con
# la expresión exacta ^(rebuild|configtest|graceful)-[0-9a-f]{16}$:
#   zolvi-apache-helper@rebuild-<nonce>.service     -> rebuildhttpdconf
#   zolvi-apache-helper@configtest-<nonce>.service  -> apachectl -t
#   zolvi-apache-helper@graceful-<nonce>.service    -> apachectl -k graceful
# El nonce (aleatorio por llamada, generado por el ejecutor) SOLO nombra el archivo de
# resultado /run/zolvi-apache-helper/<op>-<nonce>.json; nunca llega a un comando.
# Por qué nonce y no InvocationID (fallo del APPLY 2026-11-10 23:57): un oneshot que
# termina bien queda inactivo y systemd lo descarga; `systemctl show` posterior devolvía
# InvocationID vacío y el ejecutor rechazó un rebuild que sí se había ejecutado.
# Cualquier otra instancia (rebuild sin nonce, restart, "rebuild;id", escapes \x2d…) sale
# con 64 sin ejecutar ningún comando. Se usa %i (literal) y NO %I (que convertiría "-"
# en "/"); se pasa como UN argumento, sin shell.
# Nunca reinicia Apache. Sin [Install]: solo arranca bajo demanda del ejecutor.
#
# Quién puede arrancarla: solo root (o quien polkit autorice para manage-units, por
# defecto solo administradores). No hay socket, timer ni puerto asociado.
#
# Auditoría de privilegios — qué se restringe y qué no (y por qué):
#   SÍ  NoNewPrivileges, ProtectKernelModules/Logs/Tunables, ProtectClock, ProtectHostname,
#       RestrictRealtime, RestrictNamespaces, LockPersonality, SystemCallArchitectures,
#       ProtectControlGroups: solo bloquean módulos de kernel, sysctl, reloj, hostname,
#       cgroups y namespaces; las dos operaciones que fallaban (lock en /etc/apache2/conf.d
#       y sincronización de /home) no dependen de ninguna. NoNewPrivileges no impide que
#       root cambie de uid (cPanel baja privilegios al tocar /home) ni use sus capabilities.
#   NO  ProtectSystem/ProtectHome/ReadOnlyPaths/InaccessiblePaths/ReadWritePaths: son
#       EXACTAMENTE lo que rompió rebuildhttpdconf (EROFS en conf.d/includes, EACCES en /home).
#   NO  PrivateTmp: cPanel usa /tmp compartido para algunos locks/temporales.
#   NO  User=/CapabilityBoundingSet: FileProtect necesita chown/fowner/dac_override como root
#       y graceful necesita kill; la lista exacta no está documentada por cPanel.
#   NO  PrivateNetwork/RestrictAddressFamilies: cPanel puede consultar cpsrvd/DNS local.
#   NO  MemoryDenyWriteExecute: el helper es Node (JIT) y cPanel usa Perl con XS.
[Unit]
Description=Zolvi Apache helper (%i) — predefined cPanel/Apache operation
AssertPathExists=/opt/zolvi-signer-executor/zolvi-apache-helper.mjs
AssertFileIsExecutable=/opt/cpanel/ea-nodejs22/bin/node
# Evita arrancar si Apache no está activo: graceful/configtest no deben "levantar" nada.
Requisite=httpd.service
After=httpd.service

[Service]
Type=oneshot
ExecStart=/opt/cpanel/ea-nodejs22/bin/node /opt/zolvi-signer-executor/zolvi-apache-helper.mjs "%i"
TimeoutStartSec=120
# Cada llamada es una instancia distinta: que systemd descarte también las fallidas
# (si no, se acumularían en `systemctl --failed`). La evidencia queda en el journal.
CollectMode=inactive-or-failed
# Resultados saneados para el ejecutor (uno por llamada; el ejecutor los borra al leerlos).
RuntimeDirectory=zolvi-apache-helper
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0022
NoNewPrivileges=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
