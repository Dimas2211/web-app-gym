# ============================================================
# BASE DE DATOS
# ============================================================

# URL de conexión usada por la app en runtime (next dev, producción)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/gym_db?schema=public"

# URL directa usada por Prisma CLI para migraciones (puede ser distinta a DATABASE_URL)
# Requerida cuando se usa connection pooling (ej. Supabase con pgBouncer)
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/gym_db?schema=public"

# ============================================================
# AUTENTICACIÓN — Auth.js v5
# ============================================================

# Secreto principal de Auth.js v5 (mínimo 32 caracteres)
AUTH_SECRET="cambia-esto-por-un-secreto-seguro-minimo-32-chars"

# URL base de la aplicación (requerida en producción)
AUTH_URL="http://localhost:3000"

# ============================================================
# ENTORNO
# ============================================================

NODE_ENV="development"

# ============================================================
# SEED — Variables opcionales para seed.base.ts
# Si no se definen, se usan los valores por defecto indicados
# ============================================================

# Modo de seed: "base" | "demo" | "full" (default: "base")
SEED_MODE="base"

# Datos del gimnasio inicial (defaults en seed.base.ts)
BASE_GYM_NAME="Mi Gimnasio"
BASE_GYM_SLUG="mi-gimnasio"
BASE_BRANCH_NAME="Sucursal Principal"
BASE_BRANCH_ADDRESS=""

# Credenciales del admin inicial
BASE_ADMIN_EMAIL="admin@migym.com"
BASE_ADMIN_PASSWORD="Cambiar1234!"
BASE_ADMIN_FIRST="Admin"
BASE_ADMIN_LAST="Principal"

# ============================================================
# SEGURIDAD — Cifrado de credenciales y secretos
# ============================================================

# Clave maestra de cifrado AES-256-GCM (32 bytes en base64).
# Requerida para cifrar/descifrar DteCredential y futuros secretos de plataforma.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NUNCA compartir ni subir al repositorio el valor real.
PLATFORM_ENCRYPTION_KEY=""

# ============================================================
# DTE — Ministerio de Hacienda (El Salvador)
# ============================================================

# Ambiente DTE activo: TEST | PRODUCTION
DTE_ENVIRONMENT="TEST"

# Credenciales MH (usuario y contraseña del emisor ante Hacienda)
DTE_MH_USER=""
DTE_MH_PASSWORD=""

# URLs de autenticación y recepción (se usan los defaults si no se definen)
# DTE_MH_AUTH_URL_TEST=""
# DTE_MH_AUTH_URL_PROD=""
# DTE_MH_RECEPTION_URL_TEST=""
# DTE_MH_RECEPTION_URL_PROD=""

# Firmador DTE externo
DTE_SIGNER_URL=""
DTE_SIGNER_CERT_KEY=""
DTE_SIGNER_CERT_NIT=""

# ============================================================
# DTE — Integración MariaDB externa (delivery documental)
# El sistema externo genera PDF, envía al cliente y archiva.
# ============================================================

# Activar entrega DTE a base MariaDB externa (false por defecto — seguro)
EXTERNAL_DTE_MARIADB_ENABLED=false

# Conexión a la base MariaDB del proveedor externo
EXTERNAL_DTE_MARIADB_HOST=
EXTERNAL_DTE_MARIADB_PORT=3306
EXTERNAL_DTE_MARIADB_USER=
EXTERNAL_DTE_MARIADB_PASSWORD=
EXTERNAL_DTE_MARIADB_DATABASE=tecnicodhcp_db_fe
EXTERNAL_DTE_MARIADB_TABLE=dtes_cit

# Tabla externa para insertar eventos de invalidación ACCEPTED.
# Sin default — debe configurarse explícitamente antes de usar la función de entrega de invalidaciones.
EXTERNAL_DTE_MARIADB_INVALIDATION_TABLE=

# Timeout de conexión a MariaDB externa en milisegundos (default: 10000)
EXTERNAL_DTE_MARIADB_TIMEOUT_MS=10000
